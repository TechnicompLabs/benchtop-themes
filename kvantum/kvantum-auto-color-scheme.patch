   public:
-    Style(bool useDark);
+    Style(bool useDark, bool followColorScheme = false);
     ~Style();
 
     void polish(QWidget *widget);
@@ -449,6 +449,12 @@ class Style : public QCommonStyle {
     void removeAnimation(QObject *animation); // For transient scrollbars
 
   private:
+    /* Whether the dark variant of the theme is used. */
+    bool useDark_;
+    /* Set when the style is about to be replaced because the color scheme
+       has changed ("kvantum-auto"). */
+    bool reloadPending_;
+
     QSvgRenderer *defaultRndr_, *themeRndr_;
     ThemeConfig *defaultSettings_, *themeSettings_, *settings_;
 
diff --git a/Kvantum/style/KvantumPlugin.cpp b/Kvantum/style/KvantumPlugin.cpp
index 0dd7410..80a0e69 100644
--- a/Kvantum/style/KvantumPlugin.cpp
+++ b/Kvantum/style/KvantumPlugin.cpp
@@ -18,6 +18,9 @@
 #include "KvantumPlugin.h"
 #include "Kvantum.h"
 
+#include <QGuiApplication>
+#include <QStyleHints>
+
 namespace Kvantum {
 QStyle *KvantumPlugin::create(const QString &key)
 {
@@ -25,12 +28,22 @@ QStyle *KvantumPlugin::create(const QString &key)
     return new Style(false);
   if (key.toLower() == "kvantum-dark")
     return new Style(true);
+  if (key.toLower() == "kvantum-auto")
+  { // follow the desktop's color scheme
+#if (QT_VERSION >= QT_VERSION_CHECK(6,5,0))
+    return new Style(QGuiApplication::styleHints()->colorScheme() == Qt::ColorScheme::Dark,
+                     true);
+#else
+    return new Style(false);
+#endif
+  }
 
   return 0;
 }
 
 QStringList KvantumPlugin::keys() const
 {
-  return QStringList() << QStringLiteral("kvantum") << QStringLiteral("kvantum-dark");
+  return QStringList() << QStringLiteral("kvantum") << QStringLiteral("kvantum-dark")
+                        << QStringLiteral("kvantum-auto");
 }
 }
