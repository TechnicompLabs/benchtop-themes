Add the "kvantum-auto" style key, which follows the desktop's color scheme.

With "kvantum-auto", the style uses the dark variant of the theme (as
"kvantum-dark" does) when QStyleHints::colorScheme() is Qt::ColorScheme::Dark,
and replaces the application style with a new one when the color scheme
changes, so that running applications switch between the light and dark
variants. It does so only while it is the application's style. With Qt 5,
which has no color scheme, the key behaves as "kvantum".

The keys "kvantum" and "kvantum-dark" are unchanged.

Technicomp Benchtop Linux. Proposed upstream: not yet.

diff --git a/Kvantum/style/Kvantum.cpp b/Kvantum/style/Kvantum.cpp
index d263fe7..c9abcdf 100644
--- a/Kvantum/style/Kvantum.cpp
+++ b/Kvantum/style/Kvantum.cpp
@@ -57,6 +57,7 @@
 #include <QWindow>
 #include <QScreen> // for isCursorOutsideWidget()
 #include <QProxyStyle> // only inside setSurfaceFormat()
+#include <QStyleHints>
 
 #define M_PI 3.14159265358979323846
 #define DISABLED_OPACITY 0.7
@@ -147,8 +148,11 @@ static inline QString getName(const QColor &col)
   return colName;
 }
 
-Style::Style(bool useDark) : QCommonStyle()
+Style::Style(bool useDark, bool followColorScheme) : QCommonStyle()
 {
+  useDark_ = useDark;
+  reloadPending_ = false;
+
   opacityTimer_ = opacityTimerOut_ = nullptr;
   animationOpacity_ = animationOpacityOut_ = 100;
   animationStartState_ = animationStartStateOut_ = "normal";
@@ -384,6 +388,30 @@ Style::Style(bool useDark) : QCommonStyle()
   }
 
   cachedOption_ = nullptr;
+
+#if (QT_VERSION >= QT_VERSION_CHECK(6,5,0))
+  if (followColorScheme)
+  {
+    /* With "kvantum-auto", the application style is replaced by a new one
+       when the color scheme changes, so that the theme, its dark variant
+       and their settings are loaded as at startup. The replacement is
+       queued because QApplication deletes the old style. */
+    connect(QGuiApplication::styleHints(), &QStyleHints::colorSchemeChanged, this,
+            [this](Qt::ColorScheme colorScheme) {
+      if (reloadPending_ || QApplication::style() != this
+          || (colorScheme == Qt::ColorScheme::Dark) == useDark_)
+      {
+        return;
+      }
+      reloadPending_ = true;
+      QTimer::singleShot(0, qApp, [] {
+        QApplication::setStyle(QStringLiteral("kvantum-auto"));
+      });
+    });
+  }
+#else
+  Q_UNUSED(followColorScheme);
+#endif
 }
 
 Style::~Style()
